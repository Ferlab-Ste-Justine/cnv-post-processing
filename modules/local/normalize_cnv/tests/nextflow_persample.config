// Scoped, via this test's own `config "./nextflow_persample.config"` directive, to the
// per-sample DRAGEN test() -- mirrors the real pipeline, which sets these for the per-sample
// NORMALIZE_CNV process only, never for NORMALIZE_CNV_JOINT (see conf/modules.config).
process {
    withName: NORMALIZE_CNV {
        ext.original_id = true
        ext.sample_filter = true
    }
}
