// Scoped, via this test's own `config "./nextflow_strip_svlen.config"` directive, to just the
// "DRAGEN_JOINT + strip_svlen" test() below -- mirrors how the real pipeline only ever sets this
// for the DRAGEN_JOINT-facing NORMALIZE_CNV_JOINT alias (see conf/modules.config), never for the
// plain per-sample NORMALIZE_CNV process this test file otherwise exercises unmodified.
process {
    withName: NORMALIZE_CNV {
        ext.strip_svlen = true
        // conf/modules.config (loaded through the root nextflow.config) turns ext.original_id on
        // for NORMALIZE_CNV, which is this test's process name too. The real joint path
        // (NORMALIZE_CNV_JOINT) turns it off, since add_original_id.awk refuses multi-sample VCFs.
        ext.original_id = false
    }
}
