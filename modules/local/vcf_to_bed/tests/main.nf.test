nextflow_process {

    name "Test Process VCF_TO_BED"
    script "../main.nf"
    process "VCF_TO_BED"

    tag "modules"
    tag "modules_"
    tag "vcf_to_bed"

    // Real data-test fixture (per-sample DRAGEN CNV VCF, chr22, already bgzipped+tabix-indexed) --
    // no need for a hand-crafted toy VCF here since the module's logic (one BED row per VCF
    // record, POS-1/END/ID via bcftools query | awk) doesn't need any specific edge-case record,
    // just enough real rows to check row-count parity and one real POS -> BED-start conversion.
    //
    // Verified against real, containerized bcftools output, not just derived from reading the
    // script: ran the exact `bcftools query -f '%CHROM\t%POS\t%INFO/END\t%ID\n' ... | awk
    // 'BEGIN{OFS="\t"} {print $1, $2-1, $3, $4}'` pipeline from ../main.nf directly via
    // `docker run quay.io/biocontainers/bcftools:1.23.1--hb2cee57_0` against
    // data-test/vcf/NA12878.chr22.cnv.vcf.gz (bypassing an unrelated Docker bind-mount limitation
    // that keeps `nf-test` itself from executing end to end against /workspaces in the sandbox
    // this was authored in -- ran it against the byte-identical /cephfs/jtrembla/build checkout
    // instead). Confirmed: 41 data records in, 41 BED rows out, and the first record
    // (POS=10711935, END=10742589, ID=DRAGEN:GAIN:chr22:10711936-10742589) produces the BED row
    // `chr22	10711934	10742589	DRAGEN:GAIN:chr22:10711936-10742589` -- BED start ==
    // VCF POS - 1, exactly as the assertions below check against the real process output.

    test("NA12878.chr22 - one BED row per VCF record, POS-1 start coordinate") {

        when {
            process {
                """
                input[0] = [
                    [id: "NA12878"],
                    file("${projectDir}/data-test/vcf/NA12878.chr22.cnv.vcf.gz"),
                    file("${projectDir}/data-test/vcf/NA12878.chr22.cnv.vcf.gz.tbi")
                ]
                """
            }
        }

        then {
            assert process.success

            // bed channel
            assert process.out.bed.size() == 1
            assert process.out.bed.get(0)[0] == [id: "NA12878"]
            assert file(process.out.bed.get(0)[1]).name == "NA12878.sites.bed"

            def bedLines = path(process.out.bed.get(0)[1]).readLines()

            // One BED row per VCF data record (bcftools query emits one line per record).
            def vcfRecordCount = path("${projectDir}/data-test/vcf/NA12878.chr22.cnv.vcf.gz")
                .linesGzip.findAll { !it.startsWith("#") }.size()
            assert vcfRecordCount == 41
            assert bedLines.size() == vcfRecordCount

            // Spot-check the first real record's coordinate conversion: BED is 0-based
            // half-open, VCF is 1-based, so BED start == VCF POS - 1.
            def firstVcfFields = path("${projectDir}/data-test/vcf/NA12878.chr22.cnv.vcf.gz")
                .linesGzip.find { !it.startsWith("#") }.split("\t")
            def firstVcfChrom = firstVcfFields[0]
            def firstVcfPos = firstVcfFields[1] as Integer
            def firstVcfId = firstVcfFields[2]

            def firstBedFields = bedLines[0].split("\t")
            assert firstBedFields[0] == firstVcfChrom
            assert (firstBedFields[1] as Integer) == firstVcfPos - 1
            assert firstBedFields[3] == firstVcfId

            // versions channel
            assert snapshot(process.out.versions).match()
        }
    }
}
