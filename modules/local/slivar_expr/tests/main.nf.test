nextflow_process {

    name "Test Process SLIVAR_EXPR"
    script "../main.nf"
    process "SLIVAR_EXPR"

    tag "modules"
    tag "modules_"
    tag "slivar_expr"

    // Runs real slivar with assets/cnv-slivar-functions.js and the --family-expr / --sample-expr
    // lines from conf/modules.config, on toy, synthetic fixtures checked into ./data/ (no S3
    // data-test/ dataset needed). The rules themselves are tested much more thoroughly, in plain
    // node, by assets/cnv-slivar-moi-harness.js; this test checks that slivar runs them as the
    // harness expects (slivar's own VCF/PED parsing, the expression wiring, its JS engine). Each
    // row ID names the harness scenario it reproduces (e.g. famA_T6_recessive is harness T6), so
    // its expected result is that scenario's line in assets/moi_scenarios.md.
    //
    // Each toy family has its OWN dedicated VCF+PED pair (never sharing a VCF with another
    // family): slivar's --family-expr mechanism evaluates every expression for every family in
    // the PED at every variant row, using whatever genotype data exists for that family's own
    // columns at that row, so a family sharing a VCF with another one sees "missing CN" on rows
    // that aren't its own. Scenarios sharing an identical pedigree shape (same affected-status
    // pattern) are combined as multiple rows of the same family, which is safe.
    //
    // Each toy .vcf is plain, uncompressed VCF text (no bgzip step needed), and carries no
    // INFO/END: the rules must read the CNV end from variant.stop, since reading a missing INFO
    // field throws in slivar. Each .vcf.tbi is an inert placeholder: SLIVAR_EXPR never reads the
    // `tbi` input, it only satisfies the process's 4-element input tuple.
    //
    // Tags are checked by parsing each row's INFO field into exact key=value pairs, not by
    // substring search (e.g. "de_novo" is a substring of "possible_de_novo"). Mode-of-inheritance
    // tags (--family-expr) are checked by key, and a record gets at most one: slivar values them
    // with the family's affected members. Parent-of-origin tags (--sample-expr) are checked by
    // value too, since which child they name is the point. The same helper is repeated in each
    // test() block rather than factored out, since nf-test's documented way to share Groovy code
    // across test() blocks is a class under a repo-level lib/ folder, which this repo doesn't have.

    test("famA: de novo / recessive / Mendelian-inconsistent / unknown CN (unaffected parents, affected son)") {

        when {
            process {
                """
                input[0] = [
                    [id: "famA"],
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famA.vcf"),
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famA.vcf.tbi"),
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famA.ped")
                ]
                input[1] = file("${projectDir}/assets/cnv-slivar-functions.js")
                """
            }
        }

        then {
            assert process.success

            def MOI_TAGS = [
                "de_novo", "de_novo_suspect", "parental_mosaicism_candidate", "dominant",
                "inherited_maternal", "inherited_paternal", "recessive", "recessive_lowconf",
                "possible_de_novo", "possible_inherited_maternal", "possible_inherited_paternal",
                "inheritance_unresolved", "mendelian_inconsistent", "unknown_cn"
            ]
            def PO_TAGS = ["po_mother", "po_father", "po_both", "po_ambiguous"]
            def infoOf = { String info -> info.tokenize(';').findAll { it.contains('=') }.collectEntries { def kv = it.split('=', 2); [(kv[0]): kv[1]] } }
            // moi: the one mode-of-inheritance tag expected, or null for none. po: parent-of-origin
            // tag -> the exact sample IDs it must name; a po_* tag not listed must be absent.
            def check = { String info, String moi, Map po = [:] ->
                def fields = infoOf(info)
                MOI_TAGS.each { tag -> assert fields.containsKey(tag) == (tag == moi) : "expected ${tag}=${tag == moi} but INFO was: ${info}" }
                PO_TAGS.each { tag ->
                    def want = po.containsKey(tag) ? (po[tag] as List).sort().join(',') : null
                    def got = fields.containsKey(tag) ? fields[tag].tokenize(',').sort().join(',') : null
                    assert got == want : "expected ${tag}=${want} but INFO was: ${info}"
                }
            }

            def lines = path(process.out.vcf.get(0)[1]).linesGzip.findAll { !it.startsWith("#") }
            assert lines.size() == 4
            def byId = lines.collectEntries { line -> def c = line.split("\t"); [(c[2]): c[7]] }

            check(byId["famA_T2_de_novo"], "de_novo")
            check(byId["famA_T6_recessive"], "recessive", [po_both: ["famA_kid"]])
            check(byId["famA_T19_mendelian_inconsistent"], "mendelian_inconsistent")
            check(byId["famA_T20_unknown_cn"], "unknown_cn")

            assert snapshot(process.out.versions).match()
        }
    }

    test("famB: dominant -- duplication inherited from an affected mother") {

        when {
            process {
                """
                input[0] = [
                    [id: "famB"],
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famB.vcf"),
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famB.vcf.tbi"),
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famB.ped")
                ]
                input[1] = file("${projectDir}/assets/cnv-slivar-functions.js")
                """
            }
        }

        then {
            assert process.success

            def MOI_TAGS = [
                "de_novo", "de_novo_suspect", "parental_mosaicism_candidate", "dominant",
                "inherited_maternal", "inherited_paternal", "recessive", "recessive_lowconf",
                "possible_de_novo", "possible_inherited_maternal", "possible_inherited_paternal",
                "inheritance_unresolved", "mendelian_inconsistent", "unknown_cn"
            ]
            def PO_TAGS = ["po_mother", "po_father", "po_both", "po_ambiguous"]
            def infoOf = { String info -> info.tokenize(';').findAll { it.contains('=') }.collectEntries { def kv = it.split('=', 2); [(kv[0]): kv[1]] } }
            def check = { String info, String moi, Map po = [:] ->
                def fields = infoOf(info)
                MOI_TAGS.each { tag -> assert fields.containsKey(tag) == (tag == moi) : "expected ${tag}=${tag == moi} but INFO was: ${info}" }
                PO_TAGS.each { tag ->
                    def want = po.containsKey(tag) ? (po[tag] as List).sort().join(',') : null
                    def got = fields.containsKey(tag) ? fields[tag].tokenize(',').sort().join(',') : null
                    assert got == want : "expected ${tag}=${want} but INFO was: ${info}"
                }
            }

            def lines = path(process.out.vcf.get(0)[1]).linesGzip.findAll { !it.startsWith("#") }
            assert lines.size() == 1
            def byId = lines.collectEntries { line -> def c = line.split("\t"); [(c[2]): c[7]] }

            check(byId["famB_T18_dominant"], "dominant", [po_mother: ["famB_kid"]])
        }
    }

    test("famC: recessive, low confidence -- duo, no father in the pedigree") {

        when {
            process {
                """
                input[0] = [
                    [id: "famC"],
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famC.vcf"),
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famC.vcf.tbi"),
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famC.ped")
                ]
                input[1] = file("${projectDir}/assets/cnv-slivar-functions.js")
                """
            }
        }

        then {
            assert process.success

            def MOI_TAGS = [
                "de_novo", "de_novo_suspect", "parental_mosaicism_candidate", "dominant",
                "inherited_maternal", "inherited_paternal", "recessive", "recessive_lowconf",
                "possible_de_novo", "possible_inherited_maternal", "possible_inherited_paternal",
                "inheritance_unresolved", "mendelian_inconsistent", "unknown_cn"
            ]
            def PO_TAGS = ["po_mother", "po_father", "po_both", "po_ambiguous"]
            def infoOf = { String info -> info.tokenize(';').findAll { it.contains('=') }.collectEntries { def kv = it.split('=', 2); [(kv[0]): kv[1]] } }
            def check = { String info, String moi, Map po = [:] ->
                def fields = infoOf(info)
                MOI_TAGS.each { tag -> assert fields.containsKey(tag) == (tag == moi) : "expected ${tag}=${tag == moi} but INFO was: ${info}" }
                PO_TAGS.each { tag ->
                    def want = po.containsKey(tag) ? (po[tag] as List).sort().join(',') : null
                    def got = fields.containsKey(tag) ? fields[tag].tokenize(',').sort().join(',') : null
                    assert got == want : "expected ${tag}=${want} but INFO was: ${info}"
                }
            }

            def lines = path(process.out.vcf.get(0)[1]).linesGzip.findAll { !it.startsWith("#") }
            assert lines.size() == 1
            def byId = lines.collectEntries { line -> def c = line.split("\t"); [(c[2]): c[7]] }

            // No father, so no parent of origin: an autosomal origin needs both parents.
            check(byId["famC_D2_recessive_lowconf"], "recessive_lowconf")
        }
    }

    test("famD: parent of origin maternal / paternal / ambiguous (all unaffected -- no MoI tag)") {

        when {
            process {
                """
                input[0] = [
                    [id: "famD"],
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famD.vcf"),
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famD.vcf.tbi"),
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famD.ped")
                ]
                input[1] = file("${projectDir}/assets/cnv-slivar-functions.js")
                """
            }
        }

        then {
            assert process.success

            def MOI_TAGS = [
                "de_novo", "de_novo_suspect", "parental_mosaicism_candidate", "dominant",
                "inherited_maternal", "inherited_paternal", "recessive", "recessive_lowconf",
                "possible_de_novo", "possible_inherited_maternal", "possible_inherited_paternal",
                "inheritance_unresolved", "mendelian_inconsistent", "unknown_cn"
            ]
            def PO_TAGS = ["po_mother", "po_father", "po_both", "po_ambiguous"]
            def infoOf = { String info -> info.tokenize(';').findAll { it.contains('=') }.collectEntries { def kv = it.split('=', 2); [(kv[0]): kv[1]] } }
            def check = { String info, String moi, Map po = [:] ->
                def fields = infoOf(info)
                MOI_TAGS.each { tag -> assert fields.containsKey(tag) == (tag == moi) : "expected ${tag}=${tag == moi} but INFO was: ${info}" }
                PO_TAGS.each { tag ->
                    def want = po.containsKey(tag) ? (po[tag] as List).sort().join(',') : null
                    def got = fields.containsKey(tag) ? fields[tag].tokenize(',').sort().join(',') : null
                    assert got == want : "expected ${tag}=${want} but INFO was: ${info}"
                }
            }

            def lines = path(process.out.vcf.get(0)[1]).linesGzip.findAll { !it.startsWith("#") }
            assert lines.size() == 3
            def byId = lines.collectEntries { line -> def c = line.split("\t"); [(c[2]): c[7]] }

            // Nobody is affected, so no mode of inheritance; parent of origin is per sample and
            // doesn't depend on affected status.
            check(byId["famD_T13_po_mother"], null, [po_mother: ["famD_kid"]])
            check(byId["famD_T21_po_father"], null, [po_father: ["famD_kid"]])
            check(byId["famD_T22_po_ambiguous"], null, [po_ambiguous: ["famD_kid"]])
        }
    }
}
