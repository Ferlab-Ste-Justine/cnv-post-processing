nextflow_process {

    name "Test Process SLIVAR_EXPR"
    script "../main.nf"
    process "SLIVAR_EXPR"

    tag "modules"
    tag "modules_"
    tag "slivar_expr"

    // Runs real slivar with assets/cnv-slivar-functions.js and the --sample-expr lines from
    // conf/modules.config, on toy, synthetic fixtures checked into ./data/ (no S3 data-test/
    // dataset needed), plus one test on the real joint trio VCF from data-test/ (fam1_joint, the
    // last one). The rules themselves are tested much more thoroughly, in plain
    // node, by assets/cnv-slivar-moi-harness.js; this test checks that slivar runs them as the
    // harness expects (slivar's own VCF/PED parsing, the expression wiring, its JS engine). Each
    // row ID names the harness scenario it reproduces (e.g. famA_T6_recessive is harness T6), so
    // its expected result is that scenario's line in assets/moi_scenarios.md.
    //
    // Each toy family has its OWN dedicated VCF+PED pair (never sharing a VCF with another
    // family): slivar evaluates every expression for every sample in the PED at every variant
    // row, using whatever genotype data exists for that sample's own column at that row, so a
    // family sharing a VCF with another one sees "missing CN" on rows that aren't its own. Scenarios sharing an identical pedigree shape (same affected-status
    // pattern) are combined as multiple rows of the same family, which is safe.
    //
    // Each toy .vcf is plain, uncompressed VCF text (no bgzip step needed). famA-famD carry no
    // INFO/END, so the rules must read the CNV end from variant.stop (reading a missing INFO
    // field throws in slivar); famXs/famXd do, which the chrX/chrY PAR checks depend on. Each .vcf.tbi is an inert placeholder: SLIVAR_EXPR never reads the
    // `tbi` input, it only satisfies the process's 4-element input tuple.
    //
    // Tags are checked by parsing each row's INFO field into exact key=value pairs, not by
    // substring search (e.g. "de_novo" is a substring of "possible_de_novo"). Every tag is a
    // --sample-expr that slivar values with the samples it is true for, so each expected tag is
    // checked with the exact sample IDs it must name (which child is the point), and every other
    // mode-of-inheritance or parent-of-origin tag must be absent. The same helper is repeated in each
    // test() block rather than factored out, since nf-test's documented way to share Groovy code
    // across test() blocks is a class under a repo-level lib/ folder, which this repo doesn't have.

    test("famA: de novo / recessive / Mendelian-inconsistent / unknown CN (unaffected parents, affected son)") {

        when {
            process {
                """
                input[0] = [
                    [id: "famA"],
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famA.vcf"),
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famA.vcf.tbi"),
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famA.ped")
                ]
                input[1] = file("${projectDir}/assets/cnv-slivar-functions.js")
                """
            }
        }

        then {
            assert process.success

            def MOI_TAGS = [
                "de_novo", "de_novo_suspect", "inherited_maternal", "inherited_paternal",
                "recessive", "recessive_lowconf", "possible_de_novo", "possible_inherited_maternal",
                "possible_inherited_paternal", "inheritance_unresolved", "mendelian_inconsistent", "unknown_cn"
            ]
            def PO_TAGS = ["po_mother", "po_father", "po_both", "po_ambiguous"]
            def infoOf = { String info -> info.tokenize(';').findAll { it.contains('=') }.collectEntries { def kv = it.split('=', 2); [(kv[0]): kv[1]] } }
            // want: every tag expected on the record -> the exact sample IDs it must name; any other
            // mode-of-inheritance or parent-of-origin tag must be absent.
            def check = { String info, Map want = [:] ->
                assert (MOI_TAGS + PO_TAGS).containsAll(want.keySet()) : "unknown tag in ${want}"
                def fields = infoOf(info)
                (MOI_TAGS + PO_TAGS).each { tag ->
                    def exp = want.containsKey(tag) ? (want[tag] as List).sort().join(',') : null
                    def got = fields.containsKey(tag) ? fields[tag].tokenize(',').sort().join(',') : null
                    assert got == exp : "expected ${tag}=${exp} but INFO was: ${info}"
                }
            }

            def lines = path(process.out.vcf.get(0)[1]).linesGzip.findAll { !it.startsWith("#") }
            assert lines.size() == 4
            def byId = lines.collectEntries { line -> def c = line.split("\t"); [(c[2]): c[7]] }

            check(byId["famA_T2_de_novo"], [de_novo: ["famA_kid"]])
            check(byId["famA_T6_recessive"], [recessive: ["famA_kid"], po_both: ["famA_kid"]])
            check(byId["famA_T19_mendelian_inconsistent"], [mendelian_inconsistent: ["famA_kid"]])
            check(byId["famA_T20_unknown_cn"], [unknown_cn: ["famA_kid"]])

            assert snapshot(process.out.versions).match()
        }
    }

