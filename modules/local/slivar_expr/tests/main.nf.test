nextflow_process {

    name "Test Process SLIVAR_EXPR"
    script "../main.nf"
    process "SLIVAR_EXPR"

    tag "modules"
    tag "modules_"
    tag "slivar_expr"

    // Toy, synthetic fixtures checked into ./data/ -- unlike this repo's other tests, this one
    // deliberately does NOT depend on the S3 data-test/ dataset.
    //
    // Four toy families (famA-D), each in its OWN dedicated VCF+PED pair (never sharing a VCF with
    // another family): slivar's --family-expr mechanism evaluates every function for every family
    // in the PED at every variant row, using whatever genotype data exists for that family's own
    // columns at that row. An earlier version of this fixture packed multiple families into one
    // shared multi-sample VCF, which produced real, execution-confirmed cross-contamination --
    // every OTHER family's own affected member showed up as "missing CN" on a row that wasn't
    // theirs, spuriously firing moi_cnv_unknown_cn for them too (it's the one function whose truth
    // value is *triggered by* missing CN, unlike the others, which just disqualify on it). One
    // family per fixture pair avoids this entirely.
    //
    // Scenarios sharing an identical pedigree shape (same affected-status pattern) are combined as
    // multiple rows of the same family; that's safe (no cross-family interaction), so famA covers
    // scenarios 1/3/5/6 and famD covers 7/8/9 in one invocation each.
    //
    // Each toy*.vcf is plain, uncompressed VCF text (not .vcf.gz), so no bgzip step is needed to
    // produce it. Each toy*.vcf.tbi is an inert placeholder: SLIVAR_EXPR's script block (see
    // ../main.nf) never reads the `tbi` input at all, only stages it, so its content is
    // irrelevant -- it exists purely to satisfy the process's 4-element input tuple shape.
    //
    // Tag presence is checked per test by parsing each row's INFO field into exact key=value pairs
    // and testing set membership -- NOT by substring search -- because several of the 9 real tag
    // names are substrings of each other (e.g. "candidate" is a substring of both
    // "de_novo_candidate" and "recessive_candidate"; "ambiguous" is a substring of
    // "parent_of_origin_ambiguous"), which a naive `.contains("tag=")` check would false-positive
    // on. The exact same tiny helper is repeated in each test() block below rather than factored
    // out to a shared top-level def, since nf-test's documented way to share Groovy code across
    // test() blocks is a class under a repo-level lib/ folder (this repo doesn't have one), not a
    // bare top-level function inside nextflow_process {} -- duplicating ~4 lines four times is a
    // smaller risk than an unverified assumption about nf-test's own scoping rules.
    //
    // Verified against real slivar output, not just derived: run directly via `docker run` with
    // the exact --vcf/--ped/--js/--family-expr invocation this process itself uses, against all 4
    // fixture pairs (bypassing an unrelated Docker bind-mount limitation that keeps `nf-test`
    // itself from executing end to end in the sandbox this was authored in -- `nf-test test
    // modules/local/slivar_expr` fails there with a `.command.run: No such file or directory`
    // error unrelated to this test's own correctness). Every assertion below matches the real
    // per-row INFO output exactly. One informational note from that run, not a correctness issue:
    // for famD (deliberately all-unaffected, since parent-of-origin is affected-status-agnostic),
    // slivar warns "using --family-expr without any affected samples" and writes the tag's value
    // as the family_id rather than a sample list -- irrelevant here since these assertions only
    // check tag *key* presence, never the value, but worth knowing before writing anything that
    // parses the value for an all-unaffected family. Re-run `nf-test test modules/local/slivar_expr`
    // for real in an environment without that bind-mount limitation before merging.

    test("famA: de novo / recessive / ambiguous / unknown_cn (shared unaffected-parents pedigree)") {

        when {
            process {
                """
                input[0] = [
                    [id: "famA"],
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famA.vcf"),
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famA.vcf.tbi"),
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famA.ped")
                ]
                input[1] = file("${projectDir}/assets/cnv-slivar-functions.js")
                """
            }
        }

        then {
            assert process.success

            def ALL_TAGS = [
                "de_novo_candidate", "dominant_inherited", "recessive_candidate", "candidate",
                "ambiguous", "unknown_cn",
                "parent_of_origin_maternal", "parent_of_origin_paternal", "parent_of_origin_ambiguous"
            ]
            def tagsOf = { String info -> info.tokenize(';').findAll { it.contains('=') }.collect { it.tokenize('=')[0] } as Set }
            def check = { String info, List wantTrue ->
                def present = tagsOf(info)
                ALL_TAGS.each { tag -> assert present.contains(tag) == wantTrue.contains(tag) : "expected ${tag}=${wantTrue.contains(tag)} but INFO was: ${info}" }
            }

            def lines = path(process.out.vcf.get(0)[1]).linesGzip.findAll { !it.startsWith("#") }
            assert lines.size() == 4
            def byId = lines.collectEntries { line -> def c = line.split("\t"); [(c[2]): c[7]] }

            check(byId["famA_1_denovo"], ["de_novo_candidate"])
            check(byId["famA_3_recessive"], ["recessive_candidate", "parent_of_origin_maternal", "parent_of_origin_paternal"])
            check(byId["famA_5_ambiguous"], ["ambiguous"])
            check(byId["famA_6_unknown_cn"], ["unknown_cn"])

            assert snapshot(process.out.versions).match()
        }
    }

    test("famB: dominant inheritance from an affected parent (+ resolvable parent-of-origin)") {

        when {
            process {
                """
                input[0] = [
                    [id: "famB"],
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famB.vcf"),
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famB.vcf.tbi"),
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famB.ped")
                ]
                input[1] = file("${projectDir}/assets/cnv-slivar-functions.js")
                """
            }
        }

        then {
            assert process.success

            def ALL_TAGS = [
                "de_novo_candidate", "dominant_inherited", "recessive_candidate", "candidate",
                "ambiguous", "unknown_cn",
                "parent_of_origin_maternal", "parent_of_origin_paternal", "parent_of_origin_ambiguous"
            ]
            def tagsOf = { String info -> info.tokenize(';').findAll { it.contains('=') }.collect { it.tokenize('=')[0] } as Set }

            def lines = path(process.out.vcf.get(0)[1]).linesGzip.findAll { !it.startsWith("#") }
            assert lines.size() == 1
            def info = lines[0].split("\t")[7]
            def present = tagsOf(info)
            def wantTrue = ["dominant_inherited", "parent_of_origin_maternal"]
            ALL_TAGS.each { tag -> assert present.contains(tag) == wantTrue.contains(tag) : "expected ${tag}=${wantTrue.contains(tag)} but INFO was: ${info}" }
        }
    }

    test("famC: recessive candidate, incomplete trio (duo -- no dad in the pedigree at all)") {

        when {
            process {
                """
                input[0] = [
                    [id: "famC"],
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famC.vcf"),
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famC.vcf.tbi"),
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famC.ped")
                ]
                input[1] = file("${projectDir}/assets/cnv-slivar-functions.js")
                """
            }
        }

        then {
            assert process.success

            def ALL_TAGS = [
                "de_novo_candidate", "dominant_inherited", "recessive_candidate", "candidate",
                "ambiguous", "unknown_cn",
                "parent_of_origin_maternal", "parent_of_origin_paternal", "parent_of_origin_ambiguous"
            ]
            def tagsOf = { String info -> info.tokenize(';').findAll { it.contains('=') }.collect { it.tokenize('=')[0] } as Set }

            def lines = path(process.out.vcf.get(0)[1]).linesGzip.findAll { !it.startsWith("#") }
            assert lines.size() == 1
            def info = lines[0].split("\t")[7]
            def present = tagsOf(info)
            // moi_cnv_candidate is defined as moi_cnv_recessive(fam) && !all_affected_have_both_parents(fam)
            // -- it can only ever fire alongside recessive_candidate, never instead of it.
            def wantTrue = ["recessive_candidate", "candidate"]
            ALL_TAGS.each { tag -> assert present.contains(tag) == wantTrue.contains(tag) : "expected ${tag}=${wantTrue.contains(tag)} but INFO was: ${info}" }
        }
    }

    test("famD: parent-of-origin maternal / paternal / ambiguous (all unaffected -- PO is affected-status-agnostic)") {

        when {
            process {
                """
                input[0] = [
                    [id: "famD"],
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famD.vcf"),
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famD.vcf.tbi"),
                    file("${projectDir}/modules/local/slivar_expr/tests/data/famD.ped")
                ]
                input[1] = file("${projectDir}/assets/cnv-slivar-functions.js")
                """
            }
        }

        then {
            assert process.success

            def ALL_TAGS = [
                "de_novo_candidate", "dominant_inherited", "recessive_candidate", "candidate",
                "ambiguous", "unknown_cn",
                "parent_of_origin_maternal", "parent_of_origin_paternal", "parent_of_origin_ambiguous"
            ]
            def tagsOf = { String info -> info.tokenize(';').findAll { it.contains('=') }.collect { it.tokenize('=')[0] } as Set }
            def check = { String info, List wantTrue ->
                def present = tagsOf(info)
                ALL_TAGS.each { tag -> assert present.contains(tag) == wantTrue.contains(tag) : "expected ${tag}=${wantTrue.contains(tag)} but INFO was: ${info}" }
            }

            def lines = path(process.out.vcf.get(0)[1]).linesGzip.findAll { !it.startsWith("#") }
            assert lines.size() == 3
            def byId = lines.collectEntries { line -> def c = line.split("\t"); [(c[2]): c[7]] }

            check(byId["famD_7_po_maternal"], ["parent_of_origin_maternal"])
            check(byId["famD_8_po_paternal"], ["parent_of_origin_paternal"])
            check(byId["famD_9_po_ambiguous"], ["parent_of_origin_ambiguous"])
        }
    }
}
