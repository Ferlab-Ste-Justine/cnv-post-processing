// Scoped, via the fam1_joint test's own `config "./nextflow_joint.config"` directive, to its
// NORMALIZE_CNV setup step on the multi-sample joint VCF. conf/modules.config (loaded through the
// root nextflow.config) turns ext.original_id and ext.sample_filter on for NORMALIZE_CNV, which is
// the setup's process name too; the pipeline's joint path (NORMALIZE_CNV_JOINT) turns them off:
// add_original_id.awk refuses multi-sample VCFs, and the joint VCF's FORMAT/FT is DRAGEN's own.
process {
    withName: NORMALIZE_CNV {
        ext.original_id = false
        ext.sample_filter = false
    }
}
