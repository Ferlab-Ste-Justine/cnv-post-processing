process {
    // Real cohort-level thresholds from conf/modules.config's withName: TRUVARI_COLLAPSE_COHORT
    // block. Used only by the test() that specifically exercises this threshold set (per-test
    // config override -- see https://www.nf-test.com/docs/configuration/, "Per-Test Config
    // Files"); every other test() in main.nf.test picks up the per-sample thresholds from the
    // top-level ./nextflow.config instead.
    withName: TRUVARI_COLLAPSE {
        ext.args = '--refdist 2000 --sizemin 1000 --pctovl 0.3 --pctsize 0.7 --pctseq 0 --sizemax -1'
    }
}
