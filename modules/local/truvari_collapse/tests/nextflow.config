params {
    modules_testdata_base_path = "${projectDir}/data-test"
}

process {
    // Real per-sample "clean CNVs" thresholds from conf/modules.config's
    // withName: TRUVARI_COLLAPSE_PERSAMPLE block -- used as the default ext.args for every
    // test() in this file unless a test overrides it with its own config (see the
    // TRUVARI_COLLAPSE_COHORT-flavored test below).
    withName: TRUVARI_COLLAPSE {
        ext.args = '--pctseq 0.00 --pctsize 0.70 --pctovl 0.70 --sizemax -1'
    }
}
