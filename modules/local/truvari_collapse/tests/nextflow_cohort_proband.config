process {
    // Real TRUVARI_COLLAPSE_COHORT settings from conf/modules.config: its thresholds plus proband
    // priority. Used only by the proband-priority test() in main.nf.test.
    withName: TRUVARI_COLLAPSE {
        ext.args = '--refdist 2000 --sizemin 1000 --pctovl 0.3 --pctsize 0.7 --pctseq 0 --sizemax -1'
        ext.proband_priority = true
    }
}
