nextflow_function {

    name "Test Subworkflow UTILS_NFCORE_CNV_POST_PROCESSING_PIPELINE validatePhenopacketFiles function"
    script "subworkflows/local/utils_nfcore_cnv_post_processing_pipeline/main.nf"
    function "validatePhenopacketFiles"

    tag "subworkflows"
    tag "utils_nfcore_cnv_post_processing_pipeline"

    // input[1] is a family's samplesheet rows, [meta, vcf, cram] each. Only familyPheno is read,
    // so the paths don't have to exist.

    test("Test Function validatePhenopacketFiles - every row with the same phenopacket passes") {
        when {
            function {
                """
                input[0] = "fam1"
                input[1] = [
                    [[familyPheno: "fam1.yaml"], "kid.vcf.gz", []],
                    [[familyPheno: "fam1.yaml"], "dad.vcf.gz", []],
                ]
                """
            }
        }
        then {
            assertAll(
                { assert function.success }
            )
        }
    }

    test("Test Function validatePhenopacketFiles - every row without a phenopacket passes") {
        when {
            function {
                """
                input[0] = "fam1"
                input[1] = [
                    [[familyPheno: null], "kid.vcf.gz", []],
                    [[familyPheno: []], "dad.vcf.gz", []],
                ]
                """
            }
        }
        then {
            assertAll(
                { assert function.success }
            )
        }
    }

    test("Test Function validatePhenopacketFiles - two different phenopackets fail") {
        when {
            function {
                """
                input[0] = "fam1"
                input[1] = [
                    [[familyPheno: "fam1.yaml"], "kid.vcf.gz", []],
                    [[familyPheno: "other.yaml"], "dad.vcf.gz", []],
                ]
                """
            }
        }
        then {
            assertAll(
                { assert function.failed },
                { assert function.stdout.any { it.contains("must reference the same familyPheno value") && it.contains("[fam1.yaml, other.yaml] in family fam1") } }
            )
        }
    }

    test("Test Function validatePhenopacketFiles - a phenopacket on some rows only fails") {
        // The family-level steps take familyPheno from the first row by sample name, so the
        // family would get family-mode Exomiser or not depending on the sample names.
        when {
            function {
                """
                input[0] = "fam1"
                input[1] = [
                    [[familyPheno: null], "dad.vcf.gz", []],
                    [[familyPheno: "fam1.yaml"], "kid.vcf.gz", []],
                ]
                """
            }
        }
        then {
            assertAll(
                { assert function.failed },
                { assert function.stdout.any { it.contains("or all leave it empty") && it.contains("[(empty), fam1.yaml] in family fam1") } }
            )
        }
    }
}
