nextflow_function {

    name "Test Subworkflow UTILS_NFCORE_CNV_POST_PROCESSING_PIPELINE pedAffectedChildren function"
    script "subworkflows/local/utils_nfcore_cnv_post_processing_pipeline/main.nf"
    function "pedAffectedChildren"

    tag "subworkflows"
    tag "utils_nfcore_cnv_post_processing_pipeline"

    test("Test Function pedAffectedChildren - trios, duos and an affected sibship") {
        // valid.ped: affected children kid (trio), duokid (mother only), kid2 (mother only),
        // duokid2 (father only) and notsequenced (not in any VCF, still a PED child). solo1 and
        // sib1 are affected but have no parent named, so they're founders, not probands.
        when {
            function {
                """
                input[0] = file("\${projectDir}/subworkflows/local/utils_nfcore_cnv_post_processing_pipeline/tests/data/valid.ped", checkIfExists: true)
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == ["kid", "duokid", "kid2", "duokid2", "notsequenced"] }
            )
        }
    }

    test("Test Function pedAffectedChildren - two affected sibs are both returned") {
        when {
            function {
                """
                input[0] = file("\${projectDir}/modules/local/slivar_expr/tests/data/famQ.ped", checkIfExists: true)
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == ["famQ_kid", "famQ_sib"] }
            )
        }
    }
}
