/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = params.publish_all? [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ] : []

    withName: EXOMISER {
        publishDir = [
            path: { params.exomiser_outdir ?: "${params.outdir}/exomiser" },
            pattern: '*{vcf.gz,vcf.gz.tbi,tsv,json,html}',
            mode: params.publish_dir_mode,
        ]
        ext.args = { "--output-filename=${meta.id}.exomiser" }
    }

    withName: EXOMISER_SINGLE {
        publishDir = [
            path: {
                def base = params.exomiser_outdir ?: "${params.outdir}/exomiser"
                "${base}/single_sample"
            },
            pattern: '*{vcf.gz,vcf.gz.tbi,tsv,json,html}',
            mode: params.publish_dir_mode,
        ]
        ext.args = { "--output-filename=${meta.id}.exomiser" }
    }

    withName: SLIVAR_EXPR {
        publishDir = [
            path: { "${params.outdir}/slivar" },
            pattern: '*.vcf.gz',
            mode: params.publish_dir_mode,
        ]
        ext.prefix = { "${meta.id}.cnv.slivar" }
        // One --family-expr per moi_cnv_*(fam) function in assets/cnv-slivar-functions.js -- each
        // becomes its own INFO/<tag>=<sample-list> field on a matching variant (confirmed to be
        // the only annotation mechanism that actually persists here; see the JS file's own header
        // comment). --family-expr (rather than --trio) is what generalizes this beyond trios --
        // it works for any family shape the PED describes (duos, singletons, sibships), mirroring
        // the sibling SNV pipeline's own moi_*(fam) design. Order doesn't matter -- the tags are
        // independent, not mutually exclusive by construction (each classifier already checks for
        // the others internally where relevant).
        ext.args = {
            [
                "--family-expr 'de_novo_candidate:moi_cnv_denovo(fam)'",
                "--family-expr 'dominant_inherited:moi_cnv_dominant(fam)'",
                "--family-expr 'recessive_candidate:moi_cnv_recessive(fam)'",
                "--family-expr 'candidate:moi_cnv_candidate(fam)'",
                "--family-expr 'ambiguous:moi_cnv_ambiguous(fam)'",
                "--family-expr 'unknown_cn:moi_cnv_unknown_cn(fam)'"
            ].join(' ')
        }
    }

    withName: NORMALIZE_CNV_JOINT {
        // DRAGEN's jointly-called VCFs (unlike its per-sample output) declare INFO/SVLEN as
        // Number=. rather than Number=A, so `bcftools norm -m -any` can't cleanly re-split it on
        // originally-multiallelic sites -- Exomiser then crashes reading the resulting
        // multi-value field as a scalar (ClassCastException, confirmed directly). SVLEN isn't
        // needed downstream (VEP/Exomiser derive size from POS/END/SVTYPE), so drop it here.
        ext.strip_svlen = true
    }

    withName: TRUVARI_COLLAPSE_PERSAMPLE {
        // Per-sample "clean CNVs" thresholds, validated during pipeline prototyping
        // (see /cephfs/jtrembla/projects/bioinfo-214-CNV-post-processing/preprocessing.sh).
        // --sizemax -1: truvari's own default (50000) silently excludes large CNVs (DRAGEN calls
        // routinely exceed that -- some >1Mb in our own trio data) from ever being considered for
        // collapse; disabled so this step isn't blind to exactly the largest, most clinically
        // significant calls.
        ext.args = '--pctseq 0.00 --pctsize 0.70 --pctovl 0.70 --sizemax -1'
    }

    withName: TRUVARI_COLLAPSE_COHORT {
        // Cohort-level collapse thresholds. --refdist/--sizemin/--pctsize kept at their originally
        // prototyped values (see preprocessing.sh) -- a parameter sweep against the NA12878 trio's
        // DRAGEN joint-called truth (truvari bench, 2026-09-09) found them to have no measurable
        // effect on precision/recall/F1 in the ranges tested. --pctovl was lowered from that same
        // prototype's 0.8 to 0.3, which was the sweep's actual optimum: F1 0.840 -> 0.867,
        // precision 0.830 -> 0.884, recall unchanged (~0.85) -- collapse can only trade FP for
        // cleanliness, never add recall, so recall being flat across the whole sweep is expected,
        // not a sign the search was inconclusive. --sizemax -1 for the same reason as above.
        ext.args = '--refdist 2000 --sizemin 1000 --pctovl 0.3 --pctsize 0.7 --pctseq 0 --sizemax -1'
    }

    withName: BCFTOOLS_SORT_INDEX_COHORT {
        publishDir = [
            path: { "${params.outdir}/truvari" },
            pattern: '*.sorted.vcf.gz*',
            mode: params.publish_dir_mode,
        ]
    }

    withName: BCFTOOLS_SORT_INDEX_JOINT {
        publishDir = [
            path: { "${params.outdir}/joint" },
            pattern: '*.sorted.vcf.gz*',
            mode: params.publish_dir_mode,
        ]
    }

    withName: BCFTOOLS_MERGE {
        publishDir = [
            path: { "${params.outdir}/merged" },
            pattern: '*.merged.vcf.gz*',
            mode: params.publish_dir_mode,
        ]
    }

    // To tune DEPTH_GENOTYPE_REFINE's hom-ref depth-ratio band, override ext.low/ext.high here --
    // see the module for the default and why it needs validating against real data before being
    // trusted clinically.

    withName: BCFTOOLS_INDEX {
        // This is the final family-level VCF (genotype-refined where every sample had a cram,
        // pass-through of the cohort-collapsed VCF otherwise) that annotation (stage 5+) reads
        // from.
        publishDir = [
            path: { "${params.outdir}/depth_refined" },
            pattern: '*.refined.vcf.gz*',
            mode: params.publish_dir_mode,
        ]
    }

    withName: ENSEMBLVEP_VEP {
        // Args/fields lifted directly from the sibling SNV pipeline's own conf/modules.config
        // (lines 114-150) -- the same field list (with MANE/RefSeq for a merged cache)
        // preprocessing.sh's own VEP prototype command already used independently, so this is
        // validated from two directions. vep_annotation selects the cache flavor:
        // 'merged' (Ensembl+RefSeq, adds --mane --merged and MANE/RefSeq fields), 'refseq'
        // (adds --refseq), or unset (plain Ensembl cache).
        def is_merged_cache = params.vep_annotation == 'merged'
        def is_refseq_cache = params.vep_annotation == 'refseq'
        // Built as one expression rather than incrementally appending to a list (`+=` inside a
        // config withName block isn't accepted by every Nextflow version's config parser).
        def cache_flavor_args = is_merged_cache ? "--mane --merged" : (is_refseq_cache ? "--refseq" : "")
        def fields = is_merged_cache
            ? "Allele,Consequence,IMPACT,SYMBOL,Feature_type,Gene,PICK,Feature,EXON,BIOTYPE,INTRON,HGVSc,HGVSp,STRAND,CDS_position,cDNA_position,Protein_position,Amino_acids,Codons,VARIANT_CLASS,HGVSg,CANONICAL,MANE,MANE_SELECT,RefSeq,REFSEQ_MATCH,BAM_EDIT,SOURCE"
            : "Allele,Consequence,IMPACT,SYMBOL,Feature_type,Gene,PICK,Feature,EXON,BIOTYPE,INTRON,HGVSc,HGVSp,STRAND,CDS_position,cDNA_position,Protein_position,Amino_acids,Codons,VARIANT_CLASS,HGVSg,CANONICAL,RefSeq"
        ext.args = "--offline --format vcf --vcf --xref_refseq --variant_class --numbers --hgvs --hgvsg --canonical --symbol --flag_pick --no_stats ${cache_flavor_args} --fields \"${fields}\""
        ext.prefix = { "variants.${meta.id}.cnv.vep" }
    }

    withName: '.*VCF_ANNOTATE_ENSEMBLVEP.*' {
        publishDir = [
            path: { params.vep_outdir ?: "${params.outdir}/ensemblvep" },
            mode: params.publish_dir_mode,
            pattern: '*{vcf.gz,vcf.gz.tbi}',
        ]
    }
}
