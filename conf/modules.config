/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = params.publish_all? [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ] : []

    withName: EXOMISER {
        publishDir = [
            path: { params.exomiser_outdir ?: "${params.outdir}/exomiser" },
            pattern: '*{vcf.gz,vcf.gz.tbi,tsv,json,html}',
            mode: params.publish_dir_mode,
        ]
        // <family>.<proband>.exomiser when run on a proband VCF, <family>.exomiser on a family VCF
        ext.args = { "--output-filename=${meta.proband ? "${meta.id}.${meta.proband}" : meta.id}.exomiser" }
    }

    withName: EXOMISER_SINGLE {
        publishDir = [
            path: {
                def base = params.exomiser_outdir ?: "${params.outdir}/exomiser"
                "${base}/single_sample"
            },
            pattern: '*{vcf.gz,vcf.gz.tbi,tsv,json,html}',
            mode: params.publish_dir_mode,
        ]
        ext.args = { "--output-filename=${meta.id}.exomiser" }
    }

    withName: SLIVAR_EXPR {
        publishDir = [
            path: { "${params.outdir}/slivar" },
            pattern: '*.vcf.gz',
            mode: params.publish_dir_mode,
        ]
        ext.prefix = { "${meta.id}.cnv.slivar" }
        // assets/cnv-slivar-functions.js:
        // - Mode of inheritance (--family-expr, as in the SNV pipeline): each tag calls
        //   has_moi_call(fam, variant, tag), true when at least one affected child of the family
        //   gets that call from cnv_moi() (TRIO_TABLE: the child and its parents). A family with
        //   several affected children can get several tags. slivar values a family tag with the
        //   family's affected members. The 14 tags are TRIO_TABLE's calls plus unknown_cn,
        //   inheritance_unresolved and mendelian_inconsistent, and on non-PAR chrX the
        //   X-linked names (X_LINKED_CALLS: x_linked_denovo, x_linked_recessive).
        // - Parent of origin (--sample-expr): cn_po_origin(sample, variant), a transmission label
        //   for every child (affected or not, duos included), valued with exactly the children it
        //   resolves. The eight outcomes are exclusive, named as in the SNV pipeline; po_denovo /
        //   po_possible_denovo repeat, per child, what the denovo / possible_denovo family tags
        //   say, and po_possible_mother / po_possible_father cover a child with one parent unknown.
        // The expected results for every named scenario are in assets/moi_scenarios.md
        // (generated by assets/cnv-slivar-moi-harness.js).
        ext.args = {
            [
                "--family-expr 'denovo:has_moi_call(fam, variant, \"denovo\")'",
                "--family-expr 'denovo_suspect:has_moi_call(fam, variant, \"denovo_suspect\")'",
                "--family-expr 'inherited_maternal:has_moi_call(fam, variant, \"inherited_maternal\")'",
                "--family-expr 'inherited_paternal:has_moi_call(fam, variant, \"inherited_paternal\")'",
                "--family-expr 'recessive:has_moi_call(fam, variant, \"recessive\")'",
                "--family-expr 'recessive_lowconf:has_moi_call(fam, variant, \"recessive_lowconf\")'",
                "--family-expr 'possible_denovo:has_moi_call(fam, variant, \"possible_denovo\")'",
                "--family-expr 'possible_inherited_maternal:has_moi_call(fam, variant, \"possible_inherited_maternal\")'",
                "--family-expr 'possible_inherited_paternal:has_moi_call(fam, variant, \"possible_inherited_paternal\")'",
                "--family-expr 'inheritance_unresolved:has_moi_call(fam, variant, \"inheritance_unresolved\")'",
                "--family-expr 'mendelian_inconsistent:has_moi_call(fam, variant, \"mendelian_inconsistent\")'",
                "--family-expr 'unknown_cn:has_moi_call(fam, variant, \"unknown_cn\")'",
                "--family-expr 'x_linked_denovo:has_moi_call(fam, variant, \"x_linked_denovo\")'",
                "--family-expr 'x_linked_recessive:has_moi_call(fam, variant, \"x_linked_recessive\")'",
                "--sample-expr 'po_mother:cn_po_origin(sample, variant) == \"maternal\"'",
                "--sample-expr 'po_father:cn_po_origin(sample, variant) == \"paternal\"'",
                "--sample-expr 'po_both:cn_po_origin(sample, variant) == \"both\"'",
                "--sample-expr 'po_ambiguous:cn_po_origin(sample, variant) == \"ambiguous\"'",
                "--sample-expr 'po_denovo:cn_po_origin(sample, variant) == \"denovo\"'",
                "--sample-expr 'po_possible_denovo:cn_po_origin(sample, variant) == \"possible_denovo\"'",
                "--sample-expr 'po_possible_mother:cn_po_origin(sample, variant) == \"possible_maternal\"'",
                "--sample-expr 'po_possible_father:cn_po_origin(sample, variant) == \"possible_paternal\"'"
            ].join(' ')
        }
    }

    withName: BCFTOOLS_INDEX_SLIVAR {
        // Indexes SLIVAR_EXPR's own output -- the pipeline's last file. Only publishes the new
        // .tbi; the vcf.gz itself is already published by SLIVAR_EXPR's own publishDir above, so
        // this doesn't need to re-publish it too (unlike BCFTOOLS_INDEX's other use after
        // DEPTH_GENOTYPE_REFINE, which is that VCF's first and only publish point).
        publishDir = [
            path: { "${params.outdir}/slivar" },
            pattern: '*.tbi',
            mode: params.publish_dir_mode,
        ]
    }

    withName: JOIN_PROBAND_CNV {
        // One VCF per proband (the PED's affected children): the proband's own calls, with the
        // family's slivar tags and FORMAT joined through FORMAT/OID.
        publishDir = [
            path: { "${params.outdir}/slivar" },
            pattern: '*.vcf.gz*',
            mode: params.publish_dir_mode,
        ]
        ext.prefix = { "${meta.id}.${meta.proband}.cnv.proband" }
    }

    withName: NORMALIZE_CNV {
        // Copy each call's ID into FORMAT/OID. truvari collapse keeps one ID per cluster but
        // copies the FORMAT fields of the calls it folds in, so the cohort VCF's OID still names
        // each sample's own call. NORMALIZE_CNV_JOINT turns it off: joint VCFs skip the collapses,
        // and their multi-sample records already carry the caller's ID.
        ext.original_id = true
    }

    withName: NORMALIZE_CNV_JOINT {
        // An alias of NORMALIZE_CNV, so Nextflow applies the NORMALIZE_CNV block above to it too
        // (base-name selectors first, then the alias's own). Turn OID off explicitly:
        // add_original_id.awk refuses multi-sample VCFs.
        ext.original_id = false
        // DRAGEN's jointly-called VCFs (unlike its per-sample output) declare INFO/SVLEN as
        // Number=. rather than Number=A, so `bcftools norm -m -any` can't cleanly re-split it on
        // originally-multiallelic sites -- Exomiser then crashes reading the resulting
        // multi-value field as a scalar (ClassCastException, confirmed directly). SVLEN isn't
        // needed downstream (VEP/Exomiser derive size from POS/END/SVTYPE), so drop it here.
        ext.strip_svlen = true
    }

    withName: TRUVARI_COLLAPSE_PERSAMPLE {
        // Per-sample "clean CNVs" thresholds, validated during pipeline prototyping
        // (see /cephfs/jtrembla/projects/bioinfo-214-CNV-post-processing/preprocessing.sh).
        // --sizemax -1: truvari's own default (50000) silently excludes large CNVs (DRAGEN calls
        // routinely exceed that -- some >1Mb in our own trio data) from ever being considered for
        // collapse; disabled so this step isn't blind to exactly the largest, most clinically
        // significant calls.
        ext.args = '--pctseq 0.00 --pctsize 0.70 --pctovl 0.70 --sizemax -1'
    }

    withName: TRUVARI_COLLAPSE_COHORT {
        // Cohort-level collapse thresholds. --refdist/--sizemin/--pctsize kept at their originally
        // prototyped values (see preprocessing.sh) -- a parameter sweep against the NA12878 trio's
        // DRAGEN joint-called truth (truvari bench, 2026-09-09) found them to have no measurable
        // effect on precision/recall/F1 in the ranges tested. --pctovl was lowered from that same
        // prototype's 0.8 to 0.3, which was the sweep's actual optimum: F1 0.840 -> 0.867,
        // precision 0.830 -> 0.884, recall unchanged (~0.85) -- collapse can only trade FP for
        // cleanliness, never add recall, so recall being flat across the whole sweep is expected,
        // not a sign the search was inconclusive. --sizemax -1 for the same reason as above.
        ext.args = '--refdist 2000 --sizemin 1000 --pctovl 0.3 --pctsize 0.7 --pctseq 0 --sizemax -1'
    }

    withName: BCFTOOLS_SORT_INDEX_COHORT {
        publishDir = [
            path: { "${params.outdir}/truvari" },
            pattern: '*.sorted.vcf.gz*',
            mode: params.publish_dir_mode,
        ]
    }

    withName: BCFTOOLS_SORT_INDEX_JOINT {
        publishDir = [
            path: { "${params.outdir}/joint" },
            pattern: '*.sorted.vcf.gz*',
            mode: params.publish_dir_mode,
        ]
    }

    withName: BCFTOOLS_MERGE {
        publishDir = [
            path: { "${params.outdir}/merged" },
            pattern: '*.merged.vcf.gz*',
            mode: params.publish_dir_mode,
        ]
    }

    // To tune DEPTH_GENOTYPE_REFINE's hom-ref depth-ratio band, override ext.low/ext.high here --
    // see the module for the default and why it needs validating against real data before being
    // trusted clinically. ext.min_size (default 5000 bp) is the shortest record it refines.

    withName: BCFTOOLS_INDEX {
        // This is the final family-level VCF (genotype-refined where every sample had a cram,
        // pass-through of the cohort-collapsed VCF otherwise) that annotation (stage 5+) reads
        // from.
        publishDir = [
            path: { "${params.outdir}/depth_refined" },
            pattern: '*.refined.vcf.gz*',
            mode: params.publish_dir_mode,
        ]
    }

    withName: ENSEMBLVEP_DOWNLOAD {
        // Using the conda container as the official one from esemblorg does not have the download_vep function used in nf-core.
        container = 'quay.io/biocontainers/ensembl-vep:114.2--pl5321h2a3209d_1'
        // No ext.when gate here (unlike the sibling SNV pipeline's own params.tools-based one) --
        // this pipeline has no tools-selection mechanism, VEP always runs, and the workflow-level
        // `if (params.download_cache)` in cnv_post_processing.nf already decides whether this
        // process is invoked at all.
        ext.args  = '--AUTO c --CONVERT --NO_BIOPERL --NO_HTSLIB --NO_TEST --NO_UPDATE'
        ext.prefix  = { "${params.vep_cache_version}_${params.vep_genome}" }
        publishDir  = [
            mode: params.publish_dir_mode,
            path: { params.outdir_cache ? "${params.outdir_cache}/": "${params.outdir}/cache/" }
        ]
    }

    withName: ENSEMBLVEP_VEP {
        // Explicitly qualified with docker.io/ so nextflow.config's global `docker.registry =
        // 'quay.io'` doesn't rewrite this into a quay.io reference that doesn't exist -- same
        // fix as modules/local/slivar_expr/main.nf's own container, confirmed directly (an
        // unqualified 'ensemblorg/ensembl-vep:release_114.2' resolved to
        // quay.io/ensemblorg/ensembl-vep:release_114.2 and failed to pull with 401/unknown).
        container = 'docker.io/ensemblorg/ensembl-vep:release_114.2'
        // Args/fields lifted directly from the sibling SNV pipeline's own conf/modules.config
        // (lines 114-150) -- the same field list (with MANE/RefSeq for a merged cache)
        // preprocessing.sh's own VEP prototype command already used independently, so this is
        // validated from two directions. vep_annotation selects the cache flavor:
        // 'merged' (Ensembl+RefSeq, adds --mane --merged and MANE/RefSeq fields), 'refseq'
        // (adds --refseq), or unset (plain Ensembl cache).
        // Local variables live inside the ext.args closure, not directly in the withName block:
        // Nextflow's strict config syntax (the default from 26.04) rejects `def` declarations
        // mixed with config statements ("Variable declarations cannot be mixed with config
        // statements"), while a closure body accepts them on every supported version.
        ext.args = {
            def is_merged_cache = params.vep_annotation == 'merged'
            def is_refseq_cache = params.vep_annotation == 'refseq'
            def cache_flavor_args = is_merged_cache ? "--mane --merged" : (is_refseq_cache ? "--refseq" : "")
            def fields = is_merged_cache
                ? "Allele,Consequence,IMPACT,SYMBOL,Feature_type,Gene,PICK,Feature,EXON,BIOTYPE,INTRON,HGVSc,HGVSp,STRAND,CDS_position,cDNA_position,Protein_position,Amino_acids,Codons,VARIANT_CLASS,HGVSg,CANONICAL,MANE,MANE_SELECT,RefSeq,REFSEQ_MATCH,BAM_EDIT,SOURCE"
                : "Allele,Consequence,IMPACT,SYMBOL,Feature_type,Gene,PICK,Feature,EXON,BIOTYPE,INTRON,HGVSc,HGVSp,STRAND,CDS_position,cDNA_position,Protein_position,Amino_acids,Codons,VARIANT_CLASS,HGVSg,CANONICAL,RefSeq"
            "--offline --format vcf --vcf --xref_refseq --variant_class --numbers --hgvs --hgvsg --canonical --symbol --flag_pick --no_stats ${cache_flavor_args} --fields \"${fields}\""
        }
        ext.prefix = { "variants.${meta.id}.cnv.vep" }
    }

    withName: '.*VCF_ANNOTATE_ENSEMBLVEP.*' {
        publishDir = [
            path: { params.vep_outdir ?: "${params.outdir}/ensemblvep" },
            mode: params.publish_dir_mode,
            pattern: '*{vcf.gz,vcf.gz.tbi}',
        ]
    }
}
